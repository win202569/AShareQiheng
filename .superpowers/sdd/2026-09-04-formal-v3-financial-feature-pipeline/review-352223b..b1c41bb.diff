+def _period_kind_for(period_end: str) -> str:
+    month_day = period_end[5:]
+    return {
+        "03-31": "Q1",
+        "06-30": "H1",
+        "09-30": "Q3",
+        "12-31": "FY",
+    }.get(month_day, "OTHER")
