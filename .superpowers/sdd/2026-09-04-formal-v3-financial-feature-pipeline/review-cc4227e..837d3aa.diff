+class FakeTransport:
+    def __init__(self, response=None, error=None):
+        self.response = response
+        self.error = error
+        self.requests = []
+
+    def send(self, request):
+        self.requests.append(request)
+        if self.error is not None:
+            raise self.error
+        return self.response
