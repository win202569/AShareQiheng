+        )
+        original = error_type("feature-stop")
+        renewal_entered = threading.Event()
+        release_renewal = threading.Event()
+        heartbeats: list[deep_worker_module._LeaseHeartbeat] = []
+        real_renew = self.store.renew_job_lease
