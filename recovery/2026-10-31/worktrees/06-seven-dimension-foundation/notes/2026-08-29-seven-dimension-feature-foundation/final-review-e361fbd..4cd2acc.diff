+                    AND feature_key='g.revenue.FY2021' AND period_key='FY2021'""",
+                    (newer_id,),
+                )
+                self.assertEqual(cursor.rowcount, 1)
+                expected_count = before + 1
+            else:
+                raise AssertionError(f"unknown child mutation: {mutation}")
+            connection.commit()
+            after = connection.execute(
