+                self.release = threading.Event()
+
+            def renew_job_lease(self, *_args, **_kwargs):
+                self.calls += 1
+                if self.calls == 1:
+                    return "2099-01-01T00:00:00+00:00"
+                self.entered.set()
+                if not self.release.wait(timeout=5):
