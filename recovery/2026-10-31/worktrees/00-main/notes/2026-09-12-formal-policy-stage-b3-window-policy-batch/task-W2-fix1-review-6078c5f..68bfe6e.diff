 def _decimal_text(value: Decimal) -> str:
     if type(value) is not Decimal or not value.is_finite():
         raise ValueError("finite Decimal required")
     if value.is_zero():
         return "0"
     fixed = format(value, "f")
     return fixed.rstrip("0").rstrip(".") if "." in fixed else fixed
 
