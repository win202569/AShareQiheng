+            if event == "call" and frame.f_code in forbidden_codes:
+                calls.append(frame.f_code.co_name)
+        try:
+            sys.setprofile(trace)
+            proof.require_verified()
+            proof.contract_hash
+            proof.canonical_bytes()
+            proof.to_dict()
+        finally:
+            sys.setprofile(previous)
+        self.assertEqual(calls, [])
