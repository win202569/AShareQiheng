+HASH_A = "a" * 64
+HASH_B = "b" * 64
+
+
+def value_wire(**changes):
+    wire = {
+        "state": "value",
+        "value": "4.2",
+        "value_type": "decimal",
+        "unit": "ratio",
+        "evidence_hashes": [HASH_B, HASH_A, HASH_B],
+        "pending": [],
+    }
+    wire.update(changes)
+    return wire
+
+
+def pending_wire(**changes):
+    wire = {
+        "origin": "runtime",
+        "code": "financial_input_missing",
+        "rule_id": None,
+        "evidence_hashes": [HASH_B, HASH_A, HASH_B],
+    }
+    wire.update(changes)
+    return wire
