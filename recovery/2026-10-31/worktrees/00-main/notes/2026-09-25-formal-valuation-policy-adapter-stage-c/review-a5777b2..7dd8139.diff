+@contextmanager
+def _temporary_attribute(owner, name, replacement):
+    original = vars(owner).get(name, _MISSING)
+    setattr(owner, name, replacement)
+    try:
+        yield
+    finally:
+        if original is _MISSING:
+            if name in vars(owner):
+                delattr(owner, name)
+        else:
+            setattr(owner, name, original)
+
