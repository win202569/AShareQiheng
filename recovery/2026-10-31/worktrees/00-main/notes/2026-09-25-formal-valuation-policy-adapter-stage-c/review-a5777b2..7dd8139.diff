+            "preconditions": list(args["adapter"]["preconditions"])}))
+        self.assertEqual(result["result_hash"], digest({k: v for k, v in result.items()
+            if k != "result_hash"}))
+        self.assertNotIn("proof", result)
+
+    def test_states_obey_metric_dependency(self):
