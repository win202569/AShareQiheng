++        def select(
++            self,
++            *,
++            source: str,
++            dataset: str,
++            parser_id: str,
++            parser_version: str,
++            mapping_version: str,
++            exchange: str,
++        ) -> tuple[FormalFactMapping, ...]:
++            return mapping_snapshots(
++                self,
++                source=source,
++                dataset=dataset,
++                parser_id=parser_id,
++                parser_version=parser_version,
++                mapping_version=mapping_version,
++                exchange=exchange,
++            )
++
