++    "status": "status_registry_hash",
++    "event": "event_registry_hash",
++}
++_ROOT_KEYS = frozenset({"schema_version", "purpose", "approval_id", *_ROLE_FIELDS.values()})
++_MANIFEST_FINGERPRINT_FIELDS = (
++    "manifest_hash",
++    "purpose",
