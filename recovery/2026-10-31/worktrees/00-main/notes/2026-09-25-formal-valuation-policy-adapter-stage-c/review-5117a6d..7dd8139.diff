+"""Signed Formal V3 feature definitions and immutable feature-bundle records."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date, datetime, timezone
+import hashlib
+import json
+import math
+import re
+import struct
+import uuid
+import weakref
