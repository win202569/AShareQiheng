++    try:
++        parsed = date.fromisoformat(value)
++    except ValueError as error:
++        raise ValueError(f"{label} must be a canonical ISO date") from error
++    if parsed.isoformat() != value:
++        raise ValueError(f"{label} must be a canonical ISO date")
++    return value
