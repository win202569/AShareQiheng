++def request_fingerprint(
++    *,
++    source: str,
++    dataset: str,
++    security_id: str | None,
++    period_or_date: str | None,
++    exchange: str | None,
++) -> str:
++    return hashlib.sha256(
++        canonical_bytes(
++            {
++                "dataset": dataset,
++                "exchange": exchange,
++                "period_or_date": period_or_date,
++                "security_id": security_id,
++                "source": source,
++            }
++        )
++    ).hexdigest()
