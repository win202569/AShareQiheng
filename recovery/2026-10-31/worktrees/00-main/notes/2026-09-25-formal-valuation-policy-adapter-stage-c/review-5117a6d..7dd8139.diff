++def _make_quarter_type():
++    fields = ("id", "security_id", "statement", "metric_key", "quarter_end", "quarter_key", "value", "unit", "nature", "accounting_basis", "mapping_version", "component_fact_ids", "evidence", "derivation_version")
++    records = {}
