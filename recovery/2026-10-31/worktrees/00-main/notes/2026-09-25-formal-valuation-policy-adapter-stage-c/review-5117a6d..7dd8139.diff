++        canonical_json: bytes
++        registry_hash: str
++        signature: str
++        key_id: str
++        mappings: tuple[FormalFactMapping, ...]
++        bindings: tuple[_FormalFactBinding, ...]
++        mapping_fingerprints: tuple[tuple[str, ...], ...]
++        binding_fingerprints: tuple[tuple[object, ...], ...]
