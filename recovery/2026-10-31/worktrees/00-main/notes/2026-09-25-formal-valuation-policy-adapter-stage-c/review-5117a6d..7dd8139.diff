+    ended = sum(f"{cutoff.year:04d}-{end}" <= cutoff.isoformat() for end in quarter_ends)
+    latest_index = cutoff.year * 4 + ended - 1
+    return tuple(
+        f"{index // 4:04d}Q{index % 4 + 1}"
+        for index in range(latest_index - 7, latest_index + 1)
+    )
