+    @dataclass(frozen=True)
+    class _GraphSnapshot:
+        manifest_bytes: bytes
+        root_hash: str
+        roles: tuple[tuple[str, bytes, str], ...]
+        policy_bytes: bytes
+        policy_hash: str
