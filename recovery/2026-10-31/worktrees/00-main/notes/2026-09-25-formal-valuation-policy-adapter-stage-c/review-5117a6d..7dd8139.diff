+    RangeConfig, parse_range_entry, _canonical, _exchange, _freeze, _text,
+)
+
+_LEGACY_CONFIG_FIELDS = frozenset(
+    {
+        "source",
+        "dataset",
+        "endpoint_url",
+        "http_method",
+        "parser_id",
+        "parser_version",
