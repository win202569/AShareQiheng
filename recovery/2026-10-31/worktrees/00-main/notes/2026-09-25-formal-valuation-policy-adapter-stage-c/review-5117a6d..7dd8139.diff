+    class Proof(metaclass=ProofMeta):
+        __slots__ = ("__weakref__",)
+
+        def __init__(self, *args, **kwargs):
+            raise TypeError("pre-policy score proofs require a genuine complete FormalScoreInput")
+
+        def __getattribute__(self, name):
