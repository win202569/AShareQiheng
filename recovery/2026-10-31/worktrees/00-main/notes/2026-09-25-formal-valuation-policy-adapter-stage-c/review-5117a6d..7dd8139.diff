+                and sibling[1] == get_thread_identity()
+                and sibling[2] is lease[1]
+                and sibling[3:5] == tuple(lease[7:9])
+                and parent_record.snapshot == lease[5]
+                and parent_record.snapshot.root_hash == sibling[7]
