+        self.assertEqual(set(bundle.blobs), set(bundle.roles))
+        with self.assertRaisesRegex(ValueError, "member"):
+            manifest.assert_member_hashes(**{
+                f"{role}_registry_hash": getattr(manifest, f"{role}_registry_hash")
+                for role in ROLES
+            })
