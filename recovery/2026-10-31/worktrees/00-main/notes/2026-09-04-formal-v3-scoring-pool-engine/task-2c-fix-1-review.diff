+        for sid, mid in ((Spoof("BJ430001"), METRICS[0]), ("BJ430001", Spoof(METRICS[0]))):
+            with self.subTest(selector=str(sid)), self.assertRaises(ValueError):
+                batch.input_for(sid, mid)
