+    def test_peer_or_v_change_expands_to_complete_cohort(self):
+        for mid in (MID, VMID):
+            with self.subTest(mid=mid):
+                self.new = copy.deepcopy(self.old)
+                slot = self.new["inputs"][0]["slots"][mid]
+                if mid == MID:
